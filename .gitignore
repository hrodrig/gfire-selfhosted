# Deny-all by default
*
.*

# Allowlist: repository metadata
!.gitignore
!VERSION
!LICENSE
!DISCLAIMER.md
!README.md
!ROADMAP.md
!AGENTS.md
!CHANGELOG.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!SECURITY.md

# Design / implementation docs (public companion)
!docs/
!docs/**

# Images (README hero, etc.)
!assets/
!assets/**

# GitHub Actions
!.github/
!.github/workflows/
!.github/workflows/**

# Deployment tree
!run/
!run/**

# Optional automation
!Makefile
!testing/
!testing/**
testing/platforms/inventory/hosts.yml

# Host data placeholder in-repo (lab / release-check only).
# Production: keep GFIRE_HOST_DATA entirely outside the clone.
!data/
!data/.keep
data/release-check/
data/postgres/
data/redis/
data/valkey/

# Generated noise
.DS_Store
*.db
data/*.db
*.db-shm
*.db-wal
.env
**/.env
!**/.env.example
