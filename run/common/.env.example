# gfire-selfhosted — TEMPLATE only. Do not commit real secrets.
#
# DISCLAIMER: use at your own risk. You are responsible for your data, secrets,
# and backups. Maintainers are not liable for loss or misuse. See DISCLAIMER.md.
#
# Canonical operator layout (same idea as gghstats-selfhosted):
#   Keep ALL live config and durable data OUTSIDE this git clone.
#   Updating / git pull on gfire-selfhosted must never overwrite your settings.
#
# This repository’s own semver is in VERSION at the repository root — bump for
# infra/doc/layout releases, not for app code.
#
# Server / dogfood setup:
#   1. export GFIRE_HOST_DATA=/home/gfire/gfire-data   # absolute path, outside the clone
#   2. mkdir -p "$GFIRE_HOST_DATA/postgres"
#      # profiles: also mkdir -p "$GFIRE_HOST_DATA/redis" and/or .../valkey
#   3. cp run/common/.env.example "${GFIRE_HOST_DATA}/.env"
#   4. Edit "${GFIRE_HOST_DATA}/.env" — set GFIRE_HOST_DATA to that same absolute path
#   5. From the clone root, prefer the wrapper (always uses HOST_DATA/.env):
#        ./run/scripts/compose-stack.sh minimal up -d
#      Or:
#        docker compose --env-file "${GFIRE_HOST_DATA}/.env" \
#          -f run/docker-compose/minimal/docker-compose.yml up -d
#
# What lives under GFIRE_HOST_DATA (you own this directory):
#   .env                 — secrets, pins, ports (never in git)
#   postgres/            — PostgreSQL data (bind-mounted; minimal stack)
#   redis/               — Redis data when using --profile redis
#   valkey/              — ValKey data when using --profile valkey
#   gfire.yaml           — optional app config file (if you mount it later)
#
# Lab-only: you may point GFIRE_HOST_DATA at this repo’s data/ directory.
# Do NOT put production secrets in the clone.
#
# Upgrading the running container to a new image (compose restart does NOT swap images):
#   1) Set GFIRE_VERSION in ${GFIRE_HOST_DATA}/.env
#   2) ./run/scripts/compose-stack.sh minimal pull
#   3) ./run/scripts/compose-stack.sh minimal up -d

# --- Required: host data directory (outside the clone on servers) ---
# Prefer an absolute path, e.g. /home/gfire/gfire-data or /var/lib/gfire
# Must match the directory that holds this .env file.
GFIRE_HOST_DATA=/home/gfire/gfire-data

# --- Engine image pin (unrelated to gfire-selfhosted VERSION) ---
# GFIRE_IMAGE=ghcr.io/hrodrig/gfire:v1.0.0
GFIRE_VERSION=v1.0.0

# Published host port for the GFire HTTP API.
GFIRE_HOST_PORT=8080

# Optional Bearer auth (off by default for lab). Set both to enable.
GFIRE_AUTH_ENABLED=false
GFIRE_AUTH_TOKEN=

# Postgres 18.4 Bookworm (compose service "postgres"; image postgres:18.4-bookworm).
# Host dir postgres/ mounts at /var/lib/postgresql (PG18+). Do not reuse a PG16 datadir.
POSTGRES_DB=gfire
POSTGRES_USER=gfire
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432

# Used by the gfire container (host "postgres" on the compose network).
# Keep user/password/db in sync with POSTGRES_* above.
GFIRE_STORAGE_BACKEND=postgres
GFIRE_STORAGE_POSTGRES_DSN=postgres://gfire:change-me@postgres:5432/gfire?sslmode=disable

# Optional Redis / ValKey profiles (compose --profile redis|valkey).
# Data dirs (bind-mounted): ${GFIRE_HOST_DATA}/redis or ${GFIRE_HOST_DATA}/valkey
#   mkdir -p "${GFIRE_HOST_DATA}/redis"   # or .../valkey
# When using redis backend, also set:
#   GFIRE_STORAGE_BACKEND=redis
#   GFIRE_STORAGE_REDIS_ADDR=redis:6379
# REDIS_HOST_PORT=6379
# VALKEY_HOST_PORT=6380
